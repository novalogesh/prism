{
  "version": 8,
  "name": "PRISM Offline",
  "center": [80.138, 13.402],
  "zoom": 14,

  "sources": {
    "openmaptiles": {
      "type": "vector"
    }
  },

  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1e8"
      }
    },

    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e8e4d8",
        "fill-opacity": 0.7
      }
    },

    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d9ead3",
        "fill-opacity": 0.8
      }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#b9dff2",
        "fill-opacity": 1
      }
    },

    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#8fc9e8",
        "line-width": 1.5
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#dedbd3",
        "fill-outline-color": "#c4c0b8",
        "fill-opacity": 0.8
      }
    },

    {
      "id": "minor-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "track",
        "path",
        "street"
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": 1.5
      }
    },

    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "in",
        "class",
        "primary",
        "secondary",
        "tertiary"
      ],
      "paint": {
        "line-color": "#f5b86b",
        "line-width": 2.5
      }
    },

    {
      "id": "highways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk"
      ],
      "paint": {
        "line-color": "#e58b8b",
        "line-width": 3.5
      }
    },

    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#999999",
        "line-width": 1,
        "line-opacity": 0.6
      }
    },

    {
      "id": "places",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "paint": {
        "circle-radius": 3,
        "circle-color": "#555555",
        "circle-opacity": 0.8
      }
    },

    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": 12,
        "text-font": ["Open Sans Regular"],
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },

    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": 10,
        "text-font": ["Open Sans Regular"],
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },

    {
      "id": "poi-detail",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi_detail",
      "minzoom": 14,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": 10,
        "text-font": ["Open Sans Regular"],
        "text-anchor": "top",
        "text-offset": [0, 0.8],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },

    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 12,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": 10,
        "text-font": ["Open Sans Regular"],
        "text-anchor": "top",
        "text-offset": [0, 0.8],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 13,
      "layout": {
        "text-field": "{name:latin}",
        "text-size": 10,
        "text-font": ["Open Sans Regular"],
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#397a9b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}

